# Copy to .env.docker; use --env-file .env.docker with every Compose command.
CLAIMLIST_BIND_IP=0.0.0.0
CLAIMLIST_PORT=1234
# Change to the actual browser address for LAN access, including the mapped port.
APP_ORIGIN=http://localhost:1234
# Keep this directory across updates; an absolute path is also supported.
CLAIMLIST_DATA_DIR=./data
TRUSTED_PROXY_IPS=
