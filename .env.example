# Optional fixed origin for a domain or reverse proxy; no trailing slash.
# Leave empty for HTTP access via localhost or this machine's actual IP addresses.
APP_ORIGIN=
# pnpm dev/start set --hostname 0.0.0.0 --port 1234 in package.json.
# Direct script/systemd execution may use these fallback environment values.
LISTEN_HOST=0.0.0.0
PORT=1234
DATABASE_PATH=./data/claim-list.sqlite
# Comma-separated exact proxy IPs; leave empty for direct access.
# Configure the trusted proxy to OVERWRITE X-Real-IP with the connection address.
TRUSTED_PROXY_IPS=
