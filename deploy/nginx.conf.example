# Replace domain, certificate paths and allowed subnets with the actual intranet.
server {
    listen 443 ssl;
    server_name claimlist.internal;
    ssl_certificate /etc/nginx/certs/claimlist.crt;
    ssl_certificate_key /etc/nginx/certs/claimlist.key;

    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 127.0.0.1;
    deny all;

    client_max_body_size 200k;
    location / {
        proxy_pass http://127.0.0.1:1234;
        proxy_set_header Host $host;
        # Always overwrite; never use a visitor-supplied X-Real-IP.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }
}
